# --- Core ---
DATABASE_URL=sqlite:///data/solar.db
# DATABASE_URL=postgresql+psycopg2://solar:solar@db:5432/solar
API_BASE_URL=http://localhost:8000

# --- Ingestion ---
HOT_FOLDER=data/hot_folder
PROCESSED_FOLDER=data/processed
HMI_LOOKBACK_MINUTES=60
INGEST_CRON_MINUTE=0
# Run the hourly APScheduler job inside the API process (docker-compose uses a separate service instead)
SCHEDULER_ENABLED=false

# --- Model ---
MODEL_WEIGHTS=backend/model/weights.pt
MODEL_INPUT_SIZE=512
SEG_THRESHOLD=0.5
MIN_SPOT_AREA_PX=4
GROUP_MERGE_RADIUS_PX=12
WOLF_K_FACTOR=1.146

# --- Calibration ---
SIGMA_THRESHOLD=15.0
INTERPOLATION_WINDOW=48
SEEING_COEFF_A=0.5
SEEING_COEFF_B=0.8
SEEING_SIGMA_PER_ARCSEC=0.04
SILSO_ENABLED=true
MAE_WINDOW=30

# --- Alerts (leave blank to disable a channel) ---
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
DRDT_THRESHOLD=20.0

# --- Telescope mount (LX200-over-TCP) ---
MOUNT_HOST=127.0.0.1
MOUNT_PORT=9999
MOUNT_TIMEOUT_S=5.0
